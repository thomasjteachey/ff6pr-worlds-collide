    <!-- ff4: FINAL FANTASY IV PR isn't installed -->
    <!-- ff5: FINAL FANTASY V PR isn't installed -->
    <PrGameDir_ff6>D:\SteamLibrary\steamapps\common\FINAL FANTASY VI PR</PrGameDir_ff6>
  </PropertyGroup>
</Project>
