<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the Worlds Collide flag model (WcFlags.cs). No game, no NuGet packages.
       Run from this folder: dotnet run -c Release [wc_flags.json] [out.tsv]
       then tools/wc_flags_check.py out.tsv checks every string against WC's own parser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WcPlugin\WcFlags.cs" />
    <Compile Include="..\WcPlugin\WcStatusClock.cs" />
  </ItemGroup>
</Project>
