<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the Worlds Collide flag model (WcFlags.cs). No game, no NuGet packages.
       Run from this folder: dotnet run -c Release [wc_flags.json] [out.tsv]
       then tools/wc_flags_check.py out.tsv checks every string against WC's own parser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- the kit's flag model: PrKit beside this folder (the project), else the kit/ submodule (the mod's repo) -->
    <Compile Include="..\PrKit\Seeds\Flags.cs" Condition="Exists('..\PrKit\Seeds\Flags.cs')" />
    <Compile Include="..\..\..\kit\pr\plugin\PrKit\Seeds\Flags.cs" Condition="!Exists('..\PrKit\Seeds\Flags.cs')" />
    <Compile Include="..\PrKit\Ff6\SnesStatusClock.cs" Condition="Exists('..\PrKit\Ff6\SnesStatusClock.cs')" />
    <Compile Include="..\..\..\kit\pr\plugin\PrKit\Ff6\SnesStatusClock.cs" Condition="!Exists('..\PrKit\Ff6\SnesStatusClock.cs')" />
  </ItemGroup>
</Project>
